(1 row)

SELECT pg_horizon_terminate_blocker(2147483647);
ERROR:  permission denied for function pg_horizon_terminate_blocker
SET pg_horizon.terminate_blockers = on;
ERROR:  permission denied to set parameter "pg_horizon.terminate_blockers"
RESET ROLE;
DROP OWNED BY horizon_plain;
DROP ROLE horizon_plain;
