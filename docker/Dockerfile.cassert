# PostgreSQL built from source with assertions, for testing pg_horizon.
# Assertions catch lock, memory-context and buffer-overrun mistakes that a
# release build hides. Build: scripts/docker-test-cassert.sh
ARG PG_VERSION=18.6
FROM debian:trixie-slim
ARG PG_VERSION
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl bzip2 bison flex perl pkg-config \
        libreadline-dev zlib1g-dev libssl-dev libipc-run-perl procps \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL "https://ftp.postgresql.org/pub/source/v${PG_VERSION}/postgresql-${PG_VERSION}.tar.bz2" \
        | tar xj -C /usr/src \
    && cd /usr/src/postgresql-${PG_VERSION} \
    && ./configure --prefix=/opt/pg --enable-cassert --enable-debug --enable-tap-tests \
        --without-icu --with-openssl CFLAGS="-O1 -g -fno-omit-frame-pointer" >/dev/null \
    && make -j"$(nproc)" -s && make install -s \
    && make -C contrib -j"$(nproc)" -s >/dev/null && make -C contrib install -s >/dev/null \
    && make -C src/test/regress pg_regress >/dev/null
RUN useradd -m postgres
ENV PATH=/opt/pg/bin:$PATH \
    PG_SRC=/usr/src/postgresql-${PG_VERSION}
COPY . /work
RUN chown -R postgres:postgres /work
WORKDIR /work
